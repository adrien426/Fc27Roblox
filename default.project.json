{
  "name": "Fc27Roblox",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$path": "src/workspace"
    },
    "Lighting": {
      "$properties": {
        "Technology": "ShadowMap"
      }
    },
    "ReplicatedStorage": {
      "Shared": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "StarterPlayer": {
      "$properties": {
        "CameraMaxZoomDistance": 160
      },
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      }
    },
    "Players": {
      "$properties": {
        "RespawnTime": 2
      }
    }
  },
  "syncbackRules": {
    "ignoreTrees": [
      "Workspace/Camera",
      "Workspace/Terrain"
    ],
    "syncCurrentCamera": false
  }
}
